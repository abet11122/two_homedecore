# ── Copy this file to `.env` and fill it in ───────────────────────────
# cp .env.example .env

# Your site's real domain. Powers canonical URLs, og:url and sitemap.xml.
SITE_URL=https://yourdomain.com

# Required to access /admin/ (set the real values in Vercel Project Settings → Environment Variables).
# Do not use either value with a PUBLIC_ prefix.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-long-unique-password

# ── AdSense ───────────────────────────────────────────────────────────
# Your publisher ID from https://adsense.google.com (Account → Settings).
# Leave blank until the site is approved and advertising is configured.
# Must be prefixed PUBLIC_ so Astro exposes it to the rendered page.
PUBLIC_ADSENSE_CLIENT_ID=

# Optional — per-placement ad unit IDs (the numeric "data-ad-slot" value
# AdSense gives you when you create each unit. Ad placements stay hidden
# unless the client ID, page permission, and CMP configuration flag are set.
PUBLIC_ADSENSE_CMP_CONFIGURED=false
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_BEFORE_RELATED=
PUBLIC_ADSENSE_SLOT_FEED=
PUBLIC_ADSENSE_SLOT_ANCHOR=
