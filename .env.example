# ── Copy this file to `.env` and fill it in ───────────────────────────
# cp .env.example .env

# This project's canonical domain. Keep it aligned with src/site.ts and public/robots.txt.
SITE_URL=https://www.smallcozyhome.store

# Admin credentials. Set real values in the deployment environment, never in this file.
# Do not use either value with a PUBLIC_ prefix.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── AdSense ───────────────────────────────────────────────────────────
# Your publisher ID from https://adsense.google.com (Account → Settings).
# Use only the client ID supplied by the site's own AdSense account.
# The ad script and units remain disabled until the consent gate is configured.
# Must be prefixed PUBLIC_ so Astro exposes it to the rendered page.
PUBLIC_ADSENSE_CLIENT_ID=

# Set the CMP flag to true only after configuring and checking the required
# consent message in AdSense. The flag itself does not collect consent.
PUBLIC_ADSENSE_CMP_CONFIGURED=false

# Per-placement ad unit IDs (the numeric "data-ad-slot" values).
# A placement renders only when its slot ID, client ID, page permission,
# and CMP configuration flag are all present.
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_TOP=
PUBLIC_ADSENSE_SLOT_IN_ARTICLE_MID=
PUBLIC_ADSENSE_SLOT_BEFORE_RELATED=
PUBLIC_ADSENSE_SLOT_FEED=
PUBLIC_ADSENSE_SLOT_ANCHOR=
