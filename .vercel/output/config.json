{
	"version": 3,
	"routes": [
		{
			"src": "^/\\.well-known(?:/.*)?$"
		},
		{
			"src": "^/((?:[^/]+/)*[^/\\.]+)$",
			"headers": {
				"Location": "/$1/"
			},
			"status": 308
		},
		{
			"src": "^/((?:[^/]+/)*[^/]+\\.\\w+)/$",
			"headers": {
				"Location": "/$1"
			},
			"status": 308
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/_image/$",
			"dest": "_render"
		},
		{
			"src": "^/404/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/api/login/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/api/logout/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/api/save/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/api/upload/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/edit/([^/]+?)/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/login/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/new/$",
			"dest": "_render"
		},
		{
			"src": "^/admin/$",
			"dest": "_render"
		},
		{
			"src": "^/llms\\.txt$",
			"dest": "_render"
		},
		{
			"src": "^/rss\\.xml$",
			"dest": "_render"
		},
		{
			"src": "^/saved/$",
			"dest": "_render"
		},
		{
			"src": "^/search/$",
			"dest": "_render"
		},
		{
			"src": "^/tags/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}