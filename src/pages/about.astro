---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../site';
import { navCategories } from '../lib/navCategories';

export const prerender = true;

const CATEGORIES = await navCategories();

// Personal copy renders only once src/site.ts → person is filled in, so no
// "[PLACEHOLDER]" text can reach the live page.
const hasPerson = !SITE.person.name.startsWith('[');
const story = SITE.person.story.filter((para) => !para.startsWith('['));

const values = [
  {
    n: '01',
    title: 'Start with measurements',
    body: 'Storage and layout ideas should start with usable dimensions, access, and the way a room is used.',
  },
  {
    n: '02',
    title: 'Explain the trade-offs',
    body: 'Guides should consider daily routines, circulation, cleaning, and room constraints alongside appearance.',
  },
  {
    n: '03',
    title: 'Show the source',
    body: 'Images are identified as illustrations, and commercial relationships are explained where they apply.',
  },
];
---

<Layout
  title="About"
  description={`${SITE.name} is an independent guide to decorating and organizing small homes — layouts, storage, renter-friendly ideas and cozy styling, measured for real rooms.`}
>
  <header class="border-b border-rule">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />
      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-14">
        <div class="lg:col-span-7">
          <p class="eyebrow">About</p>
          <h1 class="mt-4 font-display text-[2.5rem] leading-[1.05] text-ink sm:text-5xl lg:text-[3.5rem]">
            Good rooms are built slowly.
          </h1>
        </div>
        <div class="lg:col-span-5">
          <p class="text-lg leading-relaxed text-ink-60">
            {SITE.name} is an independent site about making small homes work — written for people
            decorating real rooms on real budgets, one decision at a time.
          </p>
        </div>
      </div>
    </div>
  </header>

  <section class="wrap py-12 lg:py-16">
    <div class="frame aspect-[16/9] sm:aspect-[5/2]">
      <Img
        src="photo-1616486338812-3dadae4b4ace"
        alt="A sunlit living room with linen seating and warm wood"
        width={1280}
        height={512}
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 1280px) 1180px, 100vw"
      />
    </div>
  </section>

  <section class="wrap">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <div class="article no-dropcap">
          <h2>Who runs {SITE.name}</h2>
          {hasPerson && <p>Hi, I'm {SITE.person.name}, and I run {SITE.name}.</p>}
          {story.map((para) => <p>{para}</p>)}
          <p>
            {SITE.name} is a small independent site about decorating and organizing compact homes.
            The guides are written for people living in apartments, rentals and small houses, where
            every piece of furniture has to earn its floor space.
          </p>
          <p>
            Most decorating advice assumes a big house and a big budget. These guides start with a
            tape measure and the room you actually have: what fits, what to measure first, and what a
            solution gives up in return.
          </p>

          <h2>What you'll find here</h2>
          <p>
            Practical guides to decorating and organizing compact homes: room layouts, storage that
            fits awkward corners, renter-friendly changes that come off without damage, and seasonal
            styling that doesn't swallow a small room. Each guide aims to explain the decision behind
            an idea — what to measure, what may not fit, and what a solution gives up in return —
            rather than just what it looks like.
          </p>

          <h2>How I work</h2>
          <p>
            Photos credited to me were taken in my home. Other images are licensed stock photos used to
            illustrate a style, and they are credited where the source is known.
          </p>
          <p>
            Guides are updated when I learn something new or a reader points out a mistake — the
            "Updated" date on each article shows the last revision. Room dimensions, installation
            requirements, prices and product availability vary, so measure your own space and follow
            manufacturer instructions before buying or installing anything.
          </p>
          <p>
            The site is supported by advertising and, on some pages, affiliate links. That never
            decides what I recommend. Read the <a href="/disclosure/">disclosure policy</a> for
            details, and <a href="/contact/">get in touch</a> if something in a guide is wrong.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="border border-rule p-7">
          {hasPerson && SITE.person.photo ? <img
            src={SITE.person.photo}
            alt={`Portrait of ${SITE.person.name}`}
            width="80"
            height="80"
            loading="lazy"
            class="h-20 w-20 rounded-full object-cover"
          /> : null}
          <p class="eyebrow-muted mt-5">{hasPerson ? 'The person behind the site' : 'Publisher'}</p>
          <p class="mt-2 font-display text-2xl text-ink">{hasPerson ? SITE.person.name : SITE.author}</p>
          <p class="mt-1 text-xs uppercase tracking-[0.1em] text-ink-40">{hasPerson ? SITE.person.role : SITE.authorRole}</p>
          <p class="mt-4 text-[0.9375rem] leading-relaxed text-ink-60">{hasPerson && !SITE.person.bio.startsWith('[') ? SITE.person.bio : SITE.authorBio}</p>
          <a href="/contact/" class="link-arrow mt-6">
            Get in touch
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="wrap mt-20" aria-labelledby="values-heading">
    <h2 id="values-heading" class="border-b border-rule pb-5 font-display text-2xl text-ink sm:text-3xl">
      What we believe
    </h2>
    <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-3">
      {values.map((v) => (
        <div>
          <p class="font-display text-3xl text-clay">{v.n}</p>
          <h3 class="mt-3 font-display text-xl leading-snug text-ink">{v.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-60">{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap mt-20" aria-labelledby="rooms-heading">
    <h2 id="rooms-heading" class="border-b border-rule pb-5 font-display text-2xl text-ink sm:text-3xl">
      Where to start
    </h2>
    <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      {CATEGORIES.map((c) => (
        <a href={`/category/${c.slug}/`} class="font-display text-xl text-ink transition-colors hover:text-clay sm:text-2xl">
          {c.name}
        </a>
      ))}
    </div>
  </section>

  <div class="mt-20">
    <Newsletter />
  </div>
</Layout>
