---
export const prerender = false;

const error = Astro.url.searchParams.get('error') === '1';
const next = Astro.url.searchParams.get('next')?.startsWith('/admin/')
  ? Astro.url.searchParams.get('next')!
  : '/admin/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin login — Hearth &amp; Grain</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600&display=swap" />
    <style>
      * { box-sizing: border-box; }
      body { display: grid; min-height: 100vh; margin: 0; place-items: center; padding: 24px; background: #f5f1e9; color: #29251f; font-family: Inter, system-ui, sans-serif; }
      main { width: min(100%, 420px); padding: 40px; border: 1px solid #e0d8ca; border-radius: 8px; background: #fffdfa; box-shadow: 0 16px 50px rgba(48, 39, 28, .09); }
      .mark { display: grid; width: 42px; height: 42px; place-items: center; border-radius: 7px; background: #b05b38; color: #fff; font-family: Georgia, serif; font-size: 22px; }
      h1 { margin: 22px 0 8px; font-family: 'Playfair Display', Georgia, serif; font-size: 30px; font-weight: 600; letter-spacing: -.03em; }
      p { margin: 0 0 28px; color: #70685c; font-size: 14px; line-height: 1.65; }
      label { display: block; margin: 18px 0 7px; color: #635b50; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
      input { width: 100%; min-height: 46px; padding: 11px 13px; border: 1px solid #d8d0c3; border-radius: 4px; background: #fff; color: #29251f; font: inherit; }
      input:focus { border-color: #b05b38; outline: 3px solid rgba(176, 91, 56, .13); }
      button { width: 100%; min-height: 47px; margin-top: 26px; border: 0; border-radius: 4px; background: #b05b38; color: #fff; cursor: pointer; font: inherit; font-size: 13px; font-weight: 700; letter-spacing: .03em; }
      button:hover { background: #8f4728; }
      .error { margin: 0 0 18px; padding: 10px 12px; border: 1px solid #f1b7b2; border-radius: 4px; background: #fff1f0; color: #9c3027; font-size: 13px; }
    </style>
  </head>
  <body>
    <main>
      <div class="mark" aria-hidden="true">H</div>
      <h1>Admin login</h1>
      <p>Sign in to manage Hearth &amp; Grain content.</p>
      {error && <div class="error" role="alert">That username or password is incorrect.</div>}
      <form method="post" action="/admin/api/login/">
        <input type="hidden" name="next" value={next} />
        <label for="username">Username</label>
        <input id="username" name="username" autocomplete="username" required autofocus />
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required />
        <button type="submit">Sign in</button>
      </form>
    </main>
  </body>
</html>
