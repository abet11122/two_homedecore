---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import PostCard from '../components/PostCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Newsletter from '../components/Newsletter.astro';
import { categoryName } from '../site';
import { navCategories } from '../lib/navCategories';
import { homeIdeas, IDEAS_INITIAL } from '../lib/homeIdeas';

export const prerender = true;

const CATEGORIES = await navCategories();
const PRIMARY_CATEGORIES = CATEGORIES.filter((c) => c.primary);
const { posts, featured, gridPosts } = await homeIdeas();
const initialIdeas = gridPosts.slice(0, IDEAS_INITIAL);
const shelfGuide = posts.find(p => p.id === 'diy-floating-shelves');
const picks = posts.filter(p => ['small-bedroom-ideas-that-look-expensive','apartment-decor-ideas-budget','small-entryway-organization-ideas'].includes(p.id));
---
<Layout title="Home Decor Ideas for Beautiful, Livable Spaces" description="Find home decor ideas for small bedrooms, living rooms, rentals and more. Explore practical styling guides, save your favorites and plan your next room refresh." allowAds>
  <div class="home-note"><span>A little inspiration. A home that feels like you.</span><a href="/category/small-spaces/">Small spaces, beautiful possibilities <span aria-hidden="true">↗</span></a></div>
  <section class="wrap home-hero">
    <div class="home-hero-copy">
      <p class="eyebrow hero-kicker"><span aria-hidden="true"></span>The art of feeling at home</p>
      <h1>Make room for<br /><em>the life you love.</em></h1>
      <p>Home decor ideas for real rooms, real budgets, and your own kind of beautiful. Find the little changes that make you love coming home.</p>
      <div class="hero-actions"><a class="btn btn-primary" href="#find-ideas">Explore the ideas <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#rooms-title">Find your room <span aria-hidden="true">→</span></a></div>
      <div class="hero-footnote"><span class="hero-monogram" aria-hidden="true">sch</span><div><strong>Good rooms start with a little inspiration.</strong><span>{posts.length} guides. Countless ways to make it yours.</span></div></div>
    </div>
    <div class="hero-composition">{featured && <a class="hero-feature" href={`/post/${featured.id}/`}>
      <Img src={featured.data.heroImage} alt={featured.data.title} width={900} height={1000} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 48vw, 100vw" />
      <span class="feature-label"><span aria-hidden="true">✳</span> Featured guide</span>
      <div class="feature-caption"><span>{categoryName(featured.data.category)} / The considered home</span><h2>{featured.data.title}</h2><span class="feature-arrow" aria-hidden="true">↗</span></div>
    </a>}<span class="hero-margin-note" aria-hidden="true">Spaces to settle into.</span></div>
  </section>
  <div class="wrap"><div class="editorial-values"><span><i aria-hidden="true">01</i> Inspiration for every room</span><span><i aria-hidden="true">02</i> Thoughtful ideas, realistic budgets</span><span><i aria-hidden="true">03</i> A home that’s entirely yours</span></div></div>
  <section class="wrap room-section" aria-labelledby="rooms-title">
    <div class="home-section-head"><div><p class="eyebrow">Start somewhere you love</p><h2 id="rooms-title">Which room is on your mind?</h2></div><a class="quiet-link" href="/tags/">Explore all topics ↗</a></div>
    <div class="room-grid">{PRIMARY_CATEGORIES.map(c => {
      const count = posts.filter(p => p.data.category === c.slug).length;
      return <a href={`/category/${c.slug}/`} class="room-card"><div class="frame"><Img src={c.image} alt={`${c.name} decorating inspiration`} width={320} height={380} sizes="(min-width: 900px) 15vw, 45vw" /></div><span>{c.name}<span aria-hidden="true">↗</span></span><small>{count} decorating {count === 1 ? 'guide' : 'guides'}</small></a>;
    })}</div>
  </section>
  <section class="discovery-section" id="find-ideas" aria-labelledby="ideas-title">
    <div class="wrap">
      <div class="home-section-head"><div><p class="eyebrow">The inspiration library</p><h2 id="ideas-title">A little spark for your next refresh.</h2></div><p class="section-intro">Beautiful rooms, clever details, and ideas worth saving. Find something that feels like you.</p></div>
      <div class="idea-filters" aria-label="Filter ideas by room"><button data-room="all" aria-pressed="true">All ideas</button>{CATEGORIES.map(c => <button data-room={c.slug} aria-pressed="false">{c.name}</button>)}</div>
      <p id="idea-count" class="idea-count" aria-live="polite">Explore {gridPosts.length} decorating guides.</p>
      <div class="ideas-grid" data-ideas-total={gridPosts.length}>{initialIdeas.map(post => <div data-idea-room={post.data.category}><PostCard post={post} /></div>)}</div>
      <button id="more-ideas" class="btn btn-primary more-ideas" hidden>Discover more ideas ↓</button>
    </div>
  </section>
  <div class="wrap"><AdSlot placement="feed" class="my-12" /></div>
  {shelfGuide && <section class="wrap weekend-section" aria-labelledby="weekend-title"><a class="weekend-photo frame" href={`/post/${shelfGuide.id}/`}><Img src={shelfGuide.data.heroImage} alt={shelfGuide.data.title} width={900} height={680} sizes="(min-width: 900px) 48vw, 100vw" /></a><div class="weekend-copy"><p class="eyebrow">The project planner</p><span class="weekend-number" aria-hidden="true">Plan before you drill.</span><h2 id="weekend-title">Make space for<br />the right shelf.</h2><p>Check the wall type, clearances, and the shelf maker's mounting instructions before choosing where to install floating shelves.</p><a class="link-arrow" href={`/post/${shelfGuide.id}/`}>Review the checklist <span aria-hidden="true">↗</span></a></div></section>}
  <section class="wrap budget-section" aria-labelledby="budget-title"><div class="home-section-head"><div><p class="eyebrow">Little changes, lovely results</p><h2 id="budget-title">Big on style. Kind to your budget.</h2></div><a class="quiet-link" href="/category/small-spaces/">Explore small-space ideas ↗</a></div><div class="grid gap-8 md:grid-cols-3">{picks.map(post => <PostCard post={post} />)}</div></section>
  <div class="wrap my-16"><Newsletter /></div>
</Layout>
<script>
  /*
    The grid ships IDEAS_INITIAL cards and pulls the rest from
    /partials/ideas/, so filtering still covers the whole library without the
    homepage shipping every card up front. Fetched on idle, and awaited at the
    two places that need the full set, for the times it has not landed yet.
    If that fetch fails the grid keeps working with the cards it already has.
  */
  const grid = document.querySelector<HTMLElement>('.ideas-grid')!;
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-room]');
  const more = document.querySelector<HTMLButtonElement>('#more-ideas')!;
  const count = document.querySelector<HTMLElement>('#idea-count')!;
  const total = Number(grid.dataset.ideasTotal ?? 0);
  const PAGE = 9;

  let cards = [...grid.querySelectorAll<HTMLElement>('[data-idea-room]')];
  let active = 'all';
  let limit = PAGE;
  let tail: Promise<void> | null = null;
  let complete = cards.length >= total;

  function loadTail() {
    if (complete) return Promise.resolve();
    if (!tail) {
      tail = fetch('/partials/ideas/')
        .then(response => (response.ok ? response.text() : Promise.reject(new Error(String(response.status)))))
        .then(html => {
          grid.insertAdjacentHTML('beforeend', html);
          cards = [...grid.querySelectorAll<HTMLElement>('[data-idea-room]')];
          complete = true;
          /* Save buttons ship hidden; SaveIdea unhides them in sync(). */
          document.dispatchEvent(new Event('ideas:appended'));
          /* The injected cards arrive visible, and the idle prefetch has no
             handler waiting on it, so this render is what applies the current
             filter and limit to them. */
          render();
        })
        .catch(() => { complete = true; render(); });
    }
    return tail;
  }

  function render() {
    const matching = cards.filter(card => active === 'all' || card.dataset.ideaRoom === active);
    cards.forEach(card => { card.hidden = true; });
    matching.slice(0, limit).forEach(card => { card.hidden = false; });
    const shown = Math.min(limit, matching.length);
    /*
      Until the tail lands only the "all ideas" total is knowable, so that is
      the one case read from the server count; per-room totals wait for
      loadTail(), which the filter handler awaits before it renders.
    */
    const available = active === 'all' && !complete ? total : matching.length;
    more.hidden = available <= shown;
    count.textContent = `Showing ${shown} of ${available} ${available === 1 ? 'guide' : 'guides'}`;
  }

  filters.forEach(button => button.addEventListener('click', async () => {
    filters.forEach(filter => filter.setAttribute('aria-pressed', String(filter === button)));
    active = button.dataset.room!;
    limit = PAGE;
    await loadTail();
    render();
  }));

  more.addEventListener('click', async () => {
    const previous = limit;
    await loadTail();
    limit += PAGE;
    render();
    cards.filter(card => active === 'all' || card.dataset.ideaRoom === active)[previous]
      ?.querySelector('a')?.focus({ preventScroll: true });
  });

  render();
  const idle = (window as any).requestIdleCallback;
  if (typeof idle === 'function') idle(() => loadTail());
  else setTimeout(loadTail, 1200);
</script>
