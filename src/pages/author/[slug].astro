---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import Newsletter from '../../components/Newsletter.astro';
import { SITE, CATEGORIES, categoryName, formatDateShort, isVisiblePost } from '../../site';

export const prerender = true;

/**
 * The named author's page.
 *
 * Every byline, the author box and the Article schema's Person point here,
 * so "who wrote this" resolves to one indexable page about one person
 * rather than a house byline. The old /author/editorial-team/ hub 301s
 * here (astro.config.mjs).
 */
export async function getStaticPaths() {
  return [{ params: { slug: SITE.authorSlug } }];
}

// Same gate the byline and AuthorBox use, so this page never shows a
// placeholder the rest of the site is hiding.
const hasPerson = !SITE.person.name.startsWith('[');
const name = hasPerson ? SITE.person.name : SITE.author;
const role = hasPerson ? SITE.person.role : SITE.authorRole;
const bio = hasPerson && !SITE.person.bio.startsWith('[') ? SITE.person.bio : SITE.authorBio;
const photo = hasPerson ? SITE.person.photo : SITE.authorAvatar;
const story = hasPerson ? SITE.person.story.filter((para) => !para.startsWith('[')) : [];

const posts = (await getCollection('posts')).filter(isVisiblePost).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const [latest, ...rest] = posts;
const recent = rest.slice(0, 8);

// Rooms written about most — where the archive actually sits.
const beats = CATEGORIES.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.category === c.slug).length,
}))
  .filter((c) => c.count > 0)
  .sort((a, b) => b.count - a.count);

const oldest = posts[posts.length - 1];
const description = `${name}, ${role.toLowerCase()} of ${SITE.name}. ${bio}`.slice(0, 300);

const origin = (Astro.site ?? new URL(SITE.url)).origin;
const pageUrl = `${origin}/author/${SITE.authorSlug}/`;

/*
  ProfilePage with the Person as mainEntity. The @id matches the one every
  BlogPosting's author points at (Layout.astro), so search engines resolve
  the byline and this page to the same person.
*/
const profileSchema = {
  '@type': 'ProfilePage',
  '@id': `${pageUrl}#profile`,
  url: pageUrl,
  name: `${name} — ${SITE.name}`,
  isPartOf: { '@id': `${origin}/#website` },
  ...(oldest ? { dateCreated: oldest.data.publishDate.toISOString() } : {}),
  mainEntity: hasPerson
    ? {
        '@type': 'Person',
        '@id': `${pageUrl}#person`,
        name,
        url: pageUrl,
        jobTitle: role,
        description: bio,
        ...(photo ? { image: new URL(photo, origin).href } : {}),
        worksFor: { '@id': `${origin}/#organization` },
        ...(SITE.authorLinks.length ? { sameAs: SITE.authorLinks } : {}),
      }
    : { '@id': `${origin}/#organization` },
  hasPart: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.slice(0, 20).map((post, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/post/${post.id}/`, origin).href,
      name: post.data.title,
    })),
  },
};
---

<Layout
  title={name}
  description={description}
  imageWide={latest?.data.heroImage}
  schemas={[profileSchema]}
>
  <header class="border-b border-rule bg-sand/40">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }, { label: name }]} />

      <div class="mt-8 grid gap-9 lg:grid-cols-12 lg:items-center lg:gap-14">
        {photo && <div class="lg:col-span-2">
          <img
            src={photo}
            alt={`Portrait of ${name}`}
            width="160"
            height="160"
            loading="eager"
            class="h-[7.5rem] w-[7.5rem] rounded-full object-cover lg:h-[10rem] lg:w-[10rem]"
          />
        </div>}

        <div class={photo ? 'lg:col-span-10' : 'lg:col-span-12'}>
          <p class="eyebrow">{role}, {SITE.name}</p>
          <h1 class="mt-4 font-display text-[2.5rem] leading-[1.05] text-ink sm:text-5xl lg:text-[3.5rem]">
            {name}
          </h1>
          <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-60">
            {bio}
          </p>

          <dl class="mt-8 flex flex-wrap gap-x-12 gap-y-5 border-t border-rule pt-6">
            <div>
              <dt class="eyebrow-muted">Guides</dt>
              <dd class="mt-1.5 font-display text-2xl text-ink">{posts.length}</dd>
            </div>
            <div>
              <dt class="eyebrow-muted">Rooms covered</dt>
              <dd class="mt-1.5 font-display text-2xl text-ink">{beats.length}</dd>
            </div>
            {oldest && (
              <div>
                <dt class="eyebrow-muted">Writing here since</dt>
                <dd class="mt-1.5 font-display text-2xl text-ink">
                  {oldest.data.publishDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}
                </dd>
              </div>
            )}
            <div>
              <dt class="eyebrow-muted">Get in touch</dt>
              <dd class="mt-1.5">
                <a href="/contact/" class="link-underline font-display text-2xl text-ink hover:text-clay">
                  Contact
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </header>

  {story.length > 0 && (
    <section class="wrap py-12 lg:py-16" aria-labelledby="author-method">
      <div class="article no-dropcap mx-auto max-w-reading">
        <h2 id="author-method">How I write these guides</h2>
        {story.map((para) => <p>{para}</p>)}
        <p>
          Found something wrong in a guide? <a href="/contact/">Tell me</a> and I will correct it and
          show the update date. How the site is funded is set out in the <a href="/disclosure/">disclosure policy</a>.
        </p>
      </div>
    </section>
  )}

  <section class="wrap pb-12 lg:pb-16" aria-labelledby="author-beats">
    <h2 id="author-beats" class="eyebrow-muted">What {name} writes about</h2>
    <ul class="mt-5 flex flex-wrap items-baseline gap-x-7 gap-y-3">
      {beats.map((c) => (
        <li>
          <a href={`/category/${c.slug}/`} class="link-underline font-display text-xl text-ink hover:text-clay sm:text-2xl">
            {c.name}
            <span class="ml-1.5 align-super font-body text-[0.6875rem] font-semibold text-ink-20">
              {c.count}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {latest && (
    <section class="wrap" aria-labelledby="author-latest">
      <SectionHead id="author-latest" kicker="Most recent" title="Latest guide" />
      <div class="mt-12">
        <PostCard post={latest} variant="wide" sizes="(min-width: 640px) 45vw, 90vw" />
      </div>
    </section>
  )}

  {recent.length > 0 && (
    <section class="wrap mt-16 lg:mt-20" aria-labelledby="author-archive">
      <SectionHead
        id="author-archive"
        kicker="The back catalogue"
        title={`More from ${name}`}
        href="/tags/"
        hrefLabel="Browse all"
      />
      <ol class="mt-2">
        {recent.map((post, i) => (
          <li class="group border-b border-rule">
            <a
              href={`/post/${post.id}/`}
              class="grid grid-cols-[2.75rem_1fr] items-baseline gap-5 py-6 sm:gap-8"
            >
              <span class="font-display text-2xl leading-none text-ink-20 transition-colors duration-250 group-hover:text-clay">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <span class="eyebrow-muted">
                  {categoryName(post.data.category)} · {formatDateShort(post.data.publishDate)}
                </span>
                <span class="mt-2 block font-display text-lg leading-snug text-ink transition-colors duration-250 group-hover:text-clay sm:text-xl">
                  {post.data.title}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="mt-16 lg:mt-20">
    <Newsletter />
  </div>
</Layout>
