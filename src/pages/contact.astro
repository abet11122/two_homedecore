---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../site';

export const prerender = true;

const reasons = [
  {
    title: 'Editorial & pitches',
    body: 'Story ideas, corrections, or a room of yours you would like us to feature.',
    email: SITE.email,
  },
  {
    title: 'Partnerships',
    body: 'Sponsorships, brand collaborations and press samples. We disclose every paid placement.',
    email: SITE.email,
  },
  {
    title: 'Privacy & data',
    body: 'Requests to access or delete your data, and questions about our cookie consent.',
    email: SITE.email,
  },
];
---

<Layout
  title="Contact Us"
  description={`Get in touch with ${SITE.name} — editorial pitches, partnerships and privacy requests.`}
>
  <header class="border-b border-rule">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]} />
      <p class="eyebrow mt-7">Say hello</p>
      <h1 class="mt-4 font-display text-[2.5rem] leading-[1.05] text-ink sm:text-5xl">Contact Us</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-60">
        Email the address that best matches your message. Reply times may vary.
      </p>
    </div>
  </header>

  <div class="wrap py-12 lg:py-16">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="font-display text-2xl text-ink">Contact by email</h2>
        <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-ink-60">
          Email opens in your mail application. This website does not collect messages through a form.
        </p>
        <a href={'mailto:' + SITE.email} class="link-arrow mt-6">{SITE.email}</a>
      </div>

      <aside class="lg:col-span-5">
        <h2 class="font-display text-2xl text-ink">Direct</h2>
        <div class="mt-7 divide-y divide-rule border-y border-rule">
          {reasons.map((r) => (
            <div class="py-6">
              <h3 class="font-display text-lg text-ink">{r.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-60">{r.body}</p>
              <a
                href={`mailto:${r.email}`}
                class="mt-3 inline-block text-sm text-ink underline decoration-clay underline-offset-4"
              >
                {r.email}
              </a>
            </div>
          ))}
        </div>

        <div class="mt-10">
          <p class="eyebrow-muted">Elsewhere</p>
          <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
            {SITE.pinterest && <a href={SITE.pinterest} target="_blank" rel="noopener noreferrer nofollow" class="text-ink-60 hover:text-clay">Pinterest</a>}
            {SITE.instagram && <a href={SITE.instagram} target="_blank" rel="noopener noreferrer nofollow" class="text-ink-60 hover:text-clay">Instagram</a>}
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
