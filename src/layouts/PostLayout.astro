---
import { getCollection } from 'astro:content';
import Layout from './Layout.astro';
import Img from '../components/Img.astro';
import SaveIdea from '../components/SaveIdea.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import KeyTakeaways from '../components/KeyTakeaways.astro';
import Faq from '../components/Faq.astro';
import AuthorBox from '../components/AuthorBox.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import PostNav from '../components/PostNav.astro';
import PinterestButton from '../components/PinterestButton.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import ReadingTools from '../components/ReadingTools.astro';
import '../styles/reading.css';
import { articleImage } from '../lib/articleImages';
import { SITE, categoryName, formatDate, collectTags, tagSlug, wordCount } from '../site';

interface Props {
  post: any;
  headings: Array<{ depth: number; text: string; slug: string }>;
  minutes: number;
}

const { post, headings, minutes } = Astro.props;
const d = post.data;
const heroPhoto = articleImage(d.heroImage);

const all = (await getCollection('posts')).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

/* ------------------------------------------------------------------
   Onward navigation

   Neighbours are picked from within the same room first, so "next" is a
   genuine continuation rather than whatever happened to publish that
   week. Only a category with a single post falls back to the archive.
------------------------------------------------------------------- */
const sameRoom = all.filter((p) => p.data.category === d.category);
const sequence = sameRoom.length > 1 ? sameRoom : all;
const at = sequence.findIndex((p) => p.id === post.id);
const prev = at > 0 ? sequence[at - 1] : undefined;
const next = at >= 0 && at < sequence.length - 1 ? sequence[at + 1] : undefined;

/* ------------------------------------------------------------------
   Tags

   Only tags with a hub page behind them become links; the rest stay as
   plain labels. A link to a 404 is worse than no link, and a link to a
   one-post page is close behind.
------------------------------------------------------------------- */
const hubs = new Set(collectTags(all).map((t) => t.slug));
const tags = [...new Set((d.tags ?? []).map(tagSlug))]
  .filter(Boolean)
  .map((slug: string) => ({
    slug,
    label: (d.tags as string[]).find((t) => tagSlug(t) === slug) ?? slug,
    linked: hubs.has(slug),
  }));

const words = wordCount(post.body ?? '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

/*
  FAQPage markup. Google narrowed the *rich result* to health and government
  sites in 2023, but the markup still tells every answer engine — AI Overviews,
  ChatGPT search, Perplexity — exactly which passage answers which question,
  and those are the surfaces citing this kind of content now.
*/
const faqSchema = d.faqs?.length
  ? {
      '@type': 'FAQPage',
      '@id': canonical + '#faq',
      mainEntity: d.faqs.map((f: { q: string; a: string }) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<Layout
  title={d.title}
  description={d.description}
  image={d.pinImage}
  imageWide={d.heroImage}
  type="article"
  publishDate={d.publishDate.toISOString()}
  updatedDate={d.updatedDate?.toISOString()}
  section={categoryName(d.category)}
  keywords={d.tags ?? []}
  words={words}
  minutes={minutes}
  schemas={faqSchema ? [faqSchema] : []}
>
  <div id="progress" aria-hidden="true"></div>

  <article class="wrap post-page" aria-labelledby="post-title">
    <div class="post-breadcrumbs">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: categoryName(d.category), href: `/category/${d.category}/` },
          { label: d.title },
        ]}
      />

    </div>

    <div class="post-opening">
      <header class="post-heading">
        <div class="post-kicker">
          <a href={`/category/${d.category}/`} class="eyebrow">The {categoryName(d.category).toLowerCase()} edit</a>
          <span class="post-read-time"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>{minutes} min read</span>
        </div>
        <h1 id="post-title">{d.title}</h1>
        <p class="post-deck">{d.description}</p>
        <div class="post-byline">
          <img src={SITE.authorAvatar} alt="" width="42" height="42" class="post-avatar" />
          <div>
            <a href={`/author/${SITE.authorSlug}/`}>By {SITE.author}</a>
            <p>{d.updatedDate ? 'Updated ' : ''}<time datetime={(d.updatedDate ?? d.publishDate).toISOString()}>{formatDate(d.updatedDate ?? d.publishDate)}</time><span aria-hidden="true"> · </span>{SITE.authorRole}</p>
          </div>
        </div>
        <div class="post-actions">
          <SaveIdea id={post.id} />
          <a href="#article-body" class="post-start">Start reading <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 3v14m-5-5 5 5 5-5"/></svg></a>
          <button type="button" class="post-share" data-share-url={canonical} data-share-title={d.title} aria-label="Share this article" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 16V3m-4 4 4-4 4 4M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/></svg><span>Share</span></button>
        </div>
        <p class="post-share-status" data-share-status role="status"></p>
      </header>
      <figure class="post-hero">
        <div class="frame post-hero-image">
          <Img src={d.heroImage} alt={d.heroImageAlt ?? d.title} width={900} height={1000} loading="eager" fetchpriority="high" sizes="(min-width: 1440px) 580px, (min-width: 900px) 44vw, (min-width: 640px) 85vw, 100vw" />
        </div>
        <figcaption><span>{categoryName(d.category)} inspiration</span>{heroPhoto ? <a href={heroPhoto.sourceUrl} target="_blank" rel="noopener noreferrer">Photo: {heroPhoto.photographer}</a> : <span>{SITE.name}</span>}</figcaption>
      </figure>
    </div>

    {/* A comfortable reading column, with contents in the desktop margin. */}
    <div class="post-grid">
      <aside class="post-rail hidden xl:block">
        <div class="sticky post-rail-inner">
          <TableOfContents headings={headings} variant="sidebar" />

          <div class="mt-8 border-t border-rule pt-6">
            <p class="eyebrow-muted">Keep going</p>
            <a
              href={`/category/${d.category}/`}
              class="link-arrow mt-4 text-[0.8125rem] text-ink-60 hover:text-clay"
            >
              More {categoryName(d.category).toLowerCase()}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <div class="post-body mx-auto w-full max-w-reading">
        {d.affiliateDisclosure && <AffiliateDisclosure />}

        {d.keyTakeaways?.length > 0 && <KeyTakeaways items={d.keyTakeaways} />}

        {/* The rail carries the contents from xl up; below that it sits inline. */}
        <div id="article-contents" class="xl:hidden"><TableOfContents headings={headings} /></div>

        <AdSlot placement="in-article-top" class="my-10" />

        <ReadingTools minutes={minutes} />

        <div class="article reading-article" id="article-body" tabindex="-1">
          <slot />
        </div>

        <a class="reading-back-top" href="#post-title" aria-label="Back to article title" hidden><span>Back to the top</span><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 20V4m-6 6 6-6 6 6"/></svg></a>

        {tags.length > 0 && (
          <div class="post-tags mt-12 flex flex-wrap items-center gap-2 border-t border-rule pt-7">
            <span class="eyebrow-muted mr-1">Filed under</span>
            {tags.map((tag) =>
              tag.linked ? (
                <a href={`/tag/${tag.slug}/`} class="chip-link">{tag.label}</a>
              ) : (
                <span class="border border-rule px-3 py-1 text-xs text-ink-60">{tag.label}</span>
              )
            )}
          </div>
        )}

        <AdSlot placement="in-article-mid" class="my-12" />

        <Faq items={d.faqs ?? []} />

        <section class="post-pin mt-14 border-t border-rule pt-10">
          <div class="text-center">
            <p class="eyebrow-muted">Save it</p>
            <h2 class="mt-3 font-display text-2xl text-ink sm:text-3xl">Pin this for your board</h2>
            <p class="mx-auto mt-3 max-w-md text-[0.9375rem] leading-relaxed text-ink-60">
              Tap the image to save it to Pinterest and come back to it when you are ready to start.
            </p>
          </div>
          <div class="mt-8">
            <PinterestButton image={d.pinImage} title={d.title} description={d.description} />
          </div>
        </section>

        <AuthorBox publishDate={d.publishDate} updatedDate={d.updatedDate} />

        <PostNav prev={prev} next={next} />
      </div>

      {/* A configured sidebar ad gets a separate rail only on wide screens. */}
      <aside class="post-aside hidden 2xl:block">
        <div class="sticky top-28">
          <AdSlot placement="sidebar" />
        </div>
      </aside>
    </div>

    <div class="mx-auto max-w-[72rem]">
      <AdSlot placement="before-related" class="mt-14" />
      <RelatedPosts category={d.category} currentId={post.id} />
    </div>
  </article>

  <div class="mt-16 lg:mt-24">
    <Newsletter />
  </div>

  {/* Reserve space for a configured mobile anchor ad. */}
  <div class="anchor-ad" slot="after-footer">
    <AdSlot placement="anchor" />
  </div>
</Layout>

<style is:global>
  /* Room for the mobile anchor ad */
  @media (max-width: 767px) {
    body:has(.anchor-ad .ad) {
      padding-bottom: 60px;
    }
  }
</style>
