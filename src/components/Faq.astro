---
/**
 * Reader questions, as a CSS-only accordion.
 *
 * Sits at the foot of the article on purpose: someone who scrolls this far
 * is engaged, and an open question is the single most reliable reason a
 * reader leaves for another site. Answering it here keeps the session going.
 *
 * The matching FAQPage structured data is emitted by PostLayout, so the
 * markup and the schema can never drift apart — both read the same
 * frontmatter.
 */
interface Faq {
  q: string;
  a: string;
}

interface Props {
  items: Faq[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

{items.length > 0 && (
  <section class={`mt-16 border-t border-rule pt-10 ${className}`} aria-labelledby="faq-heading">
    <p class="eyebrow-muted">Still wondering</p>
    <h2 id="faq-heading" class="mt-3 font-display text-display-3 text-ink">Common questions</h2>

    <div class="mt-8 border-t border-rule">
      {items.map((item) => (
        <details class="faq-item group border-b border-rule">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
            <h3 class="font-display text-title text-ink transition-colors group-hover:text-clay sm:text-title-lg">
              {item.q}
            </h3>
            <span class="faq-icon mt-1 grid h-6 w-6 shrink-0 place-items-center text-clay">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                <path d="M7 1v12M1 7h12"></path>
              </svg>
            </span>
          </summary>
          <p class="faq-answer pb-6 pr-10 text-[0.9375rem] leading-relaxed text-ink-60 sm:text-base">
            {item.a}
          </p>
        </details>
      ))}
    </div>
  </section>
)}
