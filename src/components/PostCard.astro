---
import Img from './Img.astro';
import SaveIdea from './SaveIdea.astro';
import { categoryName, formatDateShort, readingTime } from '../site';

interface Props {
  post: any;
  /** 'default' = stacked card, 'wide' = image beside text, 'compact' = small thumb row */
  variant?: 'default' | 'wide' | 'compact';
  eager?: boolean;
  sizes?: string;
}

const { post, variant = 'default', eager = false, sizes } = Astro.props;
const href = `/post/${post.id}/`;
const d = post.data;
const minutes = readingTime(post.body ?? '');
---

{variant === 'default' && (
  <article class="reveal group idea-card story-card">
    <a href={href} class="story-link">
      <div class="frame aspect-[4/3] story-image">
        <Img
          src={d.heroImage}
          alt={d.title}
          width={640}
          height={480}
          loading={eager ? 'eager' : 'lazy'}
          sizes={sizes ?? '(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw'}
        />
      </div>
      <div class="story-copy">
        <div class="story-kicker">
          <p class="eyebrow">{categoryName(d.category)}</p>
          <span class="story-reading">{minutes} min read</span>
        </div>
        <h3 class="story-title font-display text-title-lg text-ink">{d.title}</h3>
        <p class="clamp-2 story-description">{d.description}</p>
        <div class="story-footer">
          <time datetime={d.publishDate.toISOString()}>{formatDateShort(d.publishDate)}</time>
          <span class="story-cta">Read story <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
        </div>
      </div>
    </a>
    <div class="story-save"><SaveIdea id={post.id} title={d.title} /></div>
  </article>
)}

{variant === 'wide' && (
  <article class="reveal group story-wide grid gap-6 sm:grid-cols-12 sm:items-center">
    <a href={href} class="story-image-link sm:col-span-5" aria-label={d.title}>
      <div class="frame aspect-[4/3] story-image">
        <Img
          src={d.heroImage}
          alt={d.title}
          width={560}
          height={420}
          loading={eager ? 'eager' : 'lazy'}
          sizes={sizes ?? '(min-width: 640px) 40vw, 90vw'}
        />
      </div>
    </a>
    <div class="sm:col-span-7">
      <div class="story-kicker">
        <p class="eyebrow">{categoryName(d.category)}</p>
        <span class="story-reading">{minutes} min read</span>
      </div>
      <h3 class="story-title mt-3 font-display text-display-4 text-ink">
        <a href={href} class="transition-colors duration-250 group-hover:text-clay">{d.title}</a>
      </h3>
      <p class="clamp-2 story-description">{d.description}</p>
      <div class="story-footer">
        <time datetime={d.publishDate.toISOString()}>{formatDateShort(d.publishDate)}</time>
        <a href={href} class="story-cta" aria-label={`Read ${d.title}`}>Read story <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      </div>
    </div>
  </article>
)}

{variant === 'compact' && (
  <article class="group story-compact flex items-start gap-4">
    <a href={href} class="story-image-link shrink-0" aria-label={d.title}>
      <div class="frame aspect-square w-20 sm:w-24 story-image">
        <Img src={d.heroImage} alt={d.title} width={192} height={192} sizes="96px" />
      </div>
    </a>
    <div class="min-w-0">
      <p class="eyebrow-muted">{categoryName(d.category)}</p>
      <h3 class="mt-1.5 font-display text-title-sm text-ink">
        <a href={href} class="transition-colors group-hover:text-clay">{d.title}</a>
      </h3>
      <p class="story-compact-meta">{minutes} min read <span aria-hidden="true">&middot;</span> <time datetime={d.publishDate.toISOString()}>{formatDateShort(d.publishDate)}</time></p>
    </div>
  </article>
)}

<style>
  .story-card {
    position: relative;
    height: 100%;
    min-width: 0;
    padding-bottom: 0;
  }

  .story-link {
    display: flex;
    height: 100%;
    flex-direction: column;
  }

  .story-image {
    border-radius: 3px;
    box-shadow: none;
    isolation: isolate;
  }

  .story-card .story-image {
    border-radius: 3px;
    flex-shrink: 0;
    aspect-ratio: 4 / 3;
  }

  .story-copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px 1px 0;
  }

  .story-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 12px;
  }

  .story-kicker .eyebrow {
    color: #53634c;
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: .11em;
  }

  .story-reading {
    color: #6d7061;
    font-size: 12px;
    white-space: nowrap;
  }

  .story-title {
    margin-top: 12px;
    font-size: clamp(23px, 2.05vw, 28px);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -.025em;
    text-wrap: pretty;
    transition: color 200ms ease;
  }

  .story-link:hover .story-title {
    color: #4d6248;
  }

  .story-link:focus-visible,
  .story-image-link:focus-visible {
    outline-offset: 6px;
  }

  .story-description {
    margin-top: 12px;
    color: #62665b;
    font-size: 15px;
    line-height: 1.75;
  }

  .story-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    min-height: 45px;
    padding-top: 15px;
    margin-top: 20px;
    border-top: 1px solid #d9d9cc;
    color: #696e60;
    font-size: 12px;
  }

  .story-copy .story-footer {
    margin-top: auto;
  }

  .story-copy .story-description {
    margin-bottom: 22px;
  }

  .story-cta {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: #344b3c;
    font-size: 12px;
    font-weight: 600;
  }

  .story-cta svg {
    width: 17px;
    height: 17px;
    transition: transform 200ms ease;
  }

  .story-link:hover .story-cta svg,
  .story-cta:hover svg {
    transform: translateX(3px);
  }

  .story-save {
    position: absolute;
    z-index: 2;
    top: 13px;
    right: 13px;
  }

  .story-save :global(.save-idea) {
    margin-top: 0;
    min-height: 44px;
    padding: 10px 13px;
    font-size: 12px;
    background: rgb(251 248 244 / .96);
    border-color: rgb(255 255 255 / .75);
    box-shadow: 0 3px 14px rgb(31 27 23 / .08);
  }

  .story-save :global(.save-idea[aria-pressed='true']) {
    background: #344b3c;
    border-color: #344b3c;
    color: #fff;
  }

  .story-wide .story-footer {
    max-width: 30rem;
    padding-top: 8px;
  }

  .story-wide .story-cta {
    min-height: 44px;
  }

  .story-wide .story-title {
    max-width: 25ch;
    font-size: clamp(25px, 2.7vw, 34px);
  }

  .story-compact h3 {
    font-size: 19px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -.015em;
    text-wrap: pretty;
  }

  .story-compact .eyebrow-muted {
    font-size: 10.5px;
    color: #53634c;
    letter-spacing: .08em;
  }

  .story-compact-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    color: #696e60;
    font-size: 11px;
  }

  @media (max-width: 600px) {
    .story-card .story-image {
      aspect-ratio: 3 / 2;
    }

    .story-copy {
      padding-top: 19px;
    }

    .story-title {
      font-size: 26px;
      line-height: 1.3;
    }

    .story-description {
      font-size: 15px;
      line-height: 1.75;
    }

    .story-save {
      top: 11px;
      right: 11px;
    }

    .story-wide {
      gap: 20px;
    }

    .story-wide .story-title {
      font-size: 27px;
    }

    .story-compact {
      gap: 15px;
    }

    .story-compact h3 {
      font-size: 19px;
    }
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .group:hover .story-image :global(img) {
      transform: none;
    }

    .group:hover .story-image::before {
      opacity: 0;
    }

    .story-link:hover .story-cta svg,
    .story-cta:hover svg {
      transform: none;
    }
  }
</style>
