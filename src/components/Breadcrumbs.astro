---
import { SITE } from '../site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const site = Astro.site?.href ?? `${SITE.url}/`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, site).href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.1em] text-ink-40">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a href={item.href} class="transition-colors hover:text-clay">{item.label}</a>
        ) : (
          <span class="text-ink-60">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-ink-20">/</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
